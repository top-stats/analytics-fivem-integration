std = 'min'
max_line_length = 120

-- FiveM server natives and runtime globals.
globals = { 'TopStatsCore' }
read_globals = {
    'GetConvar', 'PerformHttpRequest', 'SetTimeout', 'AddEventHandler',
    'source', 'GetPlayers', 'GetPlayerName', 'GetPlayerIdentifierByType',
    'GetPlayerIdentifier', 'GetNumResources', 'GetCurrentResourceName',
    'exports', 'json',
}
